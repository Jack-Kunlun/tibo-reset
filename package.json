{
  "name": "tibo-reset-observatory",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Codex 额度重置观测台：网页 + 微信小程序 + 定时采集与时间预测服务",
  "scripts": {
    "collect": "node scripts/collect.mjs",
    "bootstrap": "node scripts/collect.mjs --bootstrap",
    "build": "node scripts/build.mjs",
    "refresh": "node scripts/collect.mjs && node scripts/build.mjs",
    "serve": "node server/index.mjs",
    "start": "node server/index.mjs",
    "diagnose": "node scripts/diagnose.mjs",
    "og": "node scripts/og-image.mjs",
    "preview:mp": "node scripts/preview-miniprogram.mjs",
    "make:prototype": "node scripts/make-prototype.mjs",
    "test": "node scripts/test-signals.mjs && node scripts/test-parse.mjs && node scripts/test-shared.mjs && node scripts/test-miniprogram.mjs && node scripts/test-ingest.mjs && node scripts/test-og.mjs && node scripts/test-subscribe.mjs && node scripts/test-collect-warning.mjs",
    "test:signals": "node scripts/test-signals.mjs",
    "test:parse": "node scripts/test-parse.mjs",
    "test:shared": "node scripts/test-shared.mjs",
    "test:miniprogram": "node scripts/test-miniprogram.mjs",
    "test:ingest": "node scripts/test-ingest.mjs",
    "test:og": "node scripts/test-og.mjs",
    "test:subscribe": "node scripts/test-subscribe.mjs",
    "test:collect-warning": "node scripts/test-collect-warning.mjs",
    "check:consistency": "node scripts/check-consistency.mjs",
    "check:layout": "node scripts/check-layout.mjs",
    "accept": "node scripts/acceptance.mjs",
    "check": "npm run test && node scripts/build.mjs && node scripts/check-consistency.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2"
  }
}
