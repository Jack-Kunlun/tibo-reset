/* 观测台首页样式 —— 与网页端同一套风岚水墨风 */

/* ---------- 滚动计时 ---------- */

.hero {
  text-align: center;
  padding: 56rpx 0 8rpx;
}

.hero .label {
  font-size: 23rpx;
  color: #8C8880;
  letter-spacing: 0.06em;
  margin-bottom: 22rpx;
}

.counter {
  display: flex;
  align-items: baseline;
  justify-content: center;
  flex-wrap: wrap;
  gap: 14rpx;
  font-family: "SF Mono", Menlo, Consolas, monospace;
  font-size: 100rpx;
  font-weight: 600;
  line-height: 1;
  letter-spacing: -0.01em;
}

.grp {
  display: inline-flex;
  align-items: baseline;
}

/* 数字卷轴：外层一格的窗口，内层 0-9 竖排，靠 translateY 滚动 */
.reels {
  display: inline-flex;
  align-items: baseline;
}

.reel {
  display: inline-block;
  width: 0.62em;
  height: 1em;
  overflow: hidden;
  vertical-align: baseline;
}

.reel .strip {
  transition: transform 0.55s cubic-bezier(0.18, 0.86, 0.24, 1);
}

.reel .dg {
  height: 1em;
  line-height: 1;
  text-align: center;
  font-variant-numeric: tabular-nums;
}

.counter .unit {
  font-size: 0.26em;
  color: #8C8880;
  margin-left: 8rpx;
  font-weight: 400;
  font-family: -apple-system, "PingFang SC", sans-serif;
}

.since {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #8C8880;
}

.verdict {
  display: inline-block;
  margin-top: 26rpx;
  font-size: 25rpx;
  padding: 10rpx 26rpx;
  border-radius: 99rpx;
  border: 1rpx solid #E4DFD5;
  background: #F2EFE8;
  color: #4A4842;
}

.verdict .b {
  font-weight: 620;
}

.v-watch {
  border-color: rgba(63, 115, 118, 0.34);
  background: rgba(63, 115, 118, 0.06);
  color: #2F5C5E;
}

.v-long {
  border-color: rgba(179, 86, 60, 0.34);
  background: rgba(179, 86, 60, 0.07);
  color: #8A422E;
}

.v-rare {
  border-color: rgba(179, 86, 60, 0.5);
  background: rgba(179, 86, 60, 0.12);
  color: #7A3421;
}

/* 等待已经偏久时让它轻微呼吸 —— 把结论持续推到眼前，而不是一条静态标签。
   常规区间内不呼吸：那时没什么可提醒的，一直闪反而变成噪音。 */
.verdict.v-long,
.verdict.v-rare {
  animation: breathe 3.2s ease-in-out infinite;
}

@keyframes breathe {
  0%, 100% { box-shadow: 0 0 0 0 rgba(179, 86, 60, 0); }
  50%      { box-shadow: 0 0 0 8rpx rgba(179, 86, 60, 0.09); }
}

/* ---------- 等待进度尺 ---------- */

.gauge {
  margin-top: 26rpx;
  padding: 0 8rpx;
}

.g-track {
  height: 10rpx;
  border-radius: 99rpx;
  background: #EDE9E1;
  overflow: hidden;
}

.g-fill {
  height: 100%;
  border-radius: 99rpx;
  transform-origin: left center;
  /* 从 0 长出来，比直接显示一个静态百分比更有「时间在走」的意味 */
  animation: grow 1.15s cubic-bezier(0.2, 0.75, 0.3, 1) both;
  animation-delay: 0.35s;
}

@keyframes grow {
  from { transform: scaleX(0); }
  to   { transform: scaleX(1); }
}

.g-cool .g-fill { background: linear-gradient(90deg, rgba(95, 132, 85, 0.55), #5F8455); }
.g-warm .g-fill { background: linear-gradient(90deg, rgba(63, 115, 118, 0.55), #3F7376); }
.g-hot  .g-fill { background: linear-gradient(90deg, rgba(179, 86, 60, 0.55), #B3563C); }

.g-text {
  margin-top: 12rpx;
  font-size: 21rpx;
  color: #8C8880;
  text-align: center;
}

.g-hot .g-text {
  color: #8A422E;
}

/* ---------- 进场 ---------- */
/* 让静止的首屏有「依次到位」的顺序感。刻意做得很轻：
   唱主角的是信号横幅，其它区块只是跟着浮现。 */

@keyframes rise {
  from { opacity: 0; transform: translateY(20rpx); }
  to   { opacity: 1; transform: none; }
}

.top,
.sig,
.hero,
.metrics,
.fc,
.remind,
.card,
.foot {
  animation: rise 0.55s cubic-bezier(0.2, 0.75, 0.3, 1) both;
}

.top     { animation-delay: 0.02s; }
.sig     { animation-delay: 0.06s; }
.hero    { animation-delay: 0.1s; }
.metrics { animation-delay: 0.16s; }
.fc      { animation-delay: 0.2s; }
.remind  { animation-delay: 0.24s; }
.card    { animation-delay: 0.28s; }
.foot    { animation-delay: 0.32s; }

/* ---------- 信号横幅 ---------- */
/* 有信号时这里是全页视觉重量最大的块。做法是「晕染 + 大字 + 呼吸」，
   而不是换成深色底 —— 深色底会和整站的水墨宣纸基调打架。 */

.sig {
  position: relative;
  overflow: hidden;
  margin-top: 28rpx;
  padding: 28rpx 28rpx 24rpx;
  border-radius: 22rpx;
  border: 1rpx solid rgba(179, 86, 60, 0.34);
  border-left: 8rpx solid #B3563C;
  background:
    radial-gradient(120% 88% at 0% 0%, rgba(179, 86, 60, 0.15), rgba(179, 86, 60, 0.03) 62%, rgba(255, 255, 255, 0) 100%),
    #FFFFFF;
}

.sig[data-level="hint"] {
  border-color: rgba(63, 115, 118, 0.3);
  border-left-color: #3F7376;
  background:
    radial-gradient(120% 88% at 0% 0%, rgba(63, 115, 118, 0.14), rgba(63, 115, 118, 0.03) 62%, rgba(255, 255, 255, 0) 100%),
    #FFFFFF;
}

/* 已发生：事实，不是待办。用竹绿（与「观测中」同族），与朱砂（需留意）区分。 */
.sig[data-level="occurred"] {
  border-color: rgba(95, 132, 85, 0.32);
  border-left-color: #5F8455;
  background:
    radial-gradient(120% 88% at 0% 0%, rgba(95, 132, 85, 0.15), rgba(95, 132, 85, 0.03) 62%, rgba(255, 255, 255, 0) 100%),
    #FFFFFF;
}

/* 呼吸光斑：让「有信号」这件事一直可见，而不是静着一张卡片 */
.sig-halo {
  position: absolute;
  top: -70rpx;
  left: -70rpx;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(179, 86, 60, 0.3), rgba(179, 86, 60, 0) 70%);
  animation: halo 3.8s ease-in-out infinite;
}

.sig[data-level="hint"] .sig-halo {
  background: radial-gradient(circle, rgba(63, 115, 118, 0.28), rgba(63, 115, 118, 0) 70%);
}

.sig[data-level="occurred"] .sig-halo {
  background: radial-gradient(circle, rgba(95, 132, 85, 0.28), rgba(95, 132, 85, 0) 70%);
}

@keyframes halo {
  0%, 100% { opacity: 0.4; transform: scale(1); }
  50%      { opacity: 0.95; transform: scale(1.16); }
}

.sig-head {
  position: relative;
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.badge {
  font-size: 21rpx;
  letter-spacing: 0.08em;
  padding: 5rpx 18rpx;
  border-radius: 99rpx;
  background: #B3563C;
  color: #FFFFFF;
}

/* 徽章上的活点：与光斑同频，暗示「还在扫」 */
.badge .bdot {
  display: inline-block;
  width: 10rpx;
  height: 10rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: #FFFFFF;
  animation: halo 1.9s ease-in-out infinite;
}

.sig[data-level="hint"] .badge {
  background: #3F7376;
}

.sig[data-level="occurred"] .badge {
  background: #5F8455;
}

.sig-title {
  font-size: 30rpx;
  font-weight: 650;
  flex: 1;
}

/* ---------- 大字公告 ---------- */
/* 人从「Tibo 说下周二重置」里最先抓住的就是那个星期 —— 它该是最大的字 */

.ann {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 14rpx 0 22rpx;
}

.ann-cap {
  font-size: 21rpx;
  color: #8C8880;
  letter-spacing: 0.16em;
}

.ann-big {
  font-size: 100rpx;
  font-weight: 700;
  line-height: 1.12;
  letter-spacing: 0.04em;
  color: #B3563C;
}

.sig[data-level="hint"] .ann-big {
  color: #3F7376;
}

.sig[data-level="occurred"] .ann-big {
  color: #5F8455;
}

.ann-sub {
  font-size: 24rpx;
  color: #4A4842;
  font-variant-numeric: tabular-nums;
}

/* ---------- 预告倒计时 ---------- */

.cd {
  position: relative;
  padding: 18rpx 0 20rpx;
  margin-bottom: 22rpx;
  text-align: center;
  border-top: 1rpx dashed rgba(179, 86, 60, 0.3);
  border-bottom: 1rpx dashed rgba(179, 86, 60, 0.3);
}

.cd-cap {
  display: block;
  font-size: 21rpx;
  color: #8C8880;
  letter-spacing: 0.1em;
  margin-bottom: 10rpx;
}

.cd-row {
  display: flex;
  justify-content: center;
  align-items: baseline;
  gap: 12rpx;
}

.cd-g {
  display: flex;
  align-items: baseline;
  gap: 3rpx;
}

.cd-v {
  font-size: 46rpx;
  font-weight: 680;
  font-variant-numeric: tabular-nums;
  color: #1F1E1B;
  letter-spacing: 0.01em;
}

.cd-u {
  font-size: 20rpx;
  color: #8C8880;
}

/* 窗口已开启：整组转竹青，与「还在等」区分开 */
.cd.is-over .cd-v {
  color: #5F8455;
}

.wprec {
  display: block;
  padding: 12rpx 20rpx 14rpx;
  font-size: 21rpx;
  color: #8C8880;
}

.win {
  border: 1rpx solid #E4DFD5;
  border-radius: 14rpx;
  overflow: hidden;
  background: #FFFFFF;
  margin-bottom: 20rpx;
}

.wrow {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  padding: 16rpx 20rpx;
  border-bottom: 1rpx solid #E4DFD5;
}

.wrow .k {
  font-size: 22rpx;
  color: #8C8880;
  width: 176rpx;
  flex: none;
}

.wrow .v {
  font-size: 27rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  flex: 1;
}

.wrow .z {
  font-size: 21rpx;
  color: #8C8880;
}

.wfoot {
  padding: 14rpx 20rpx;
  font-size: 22rpx;
  color: #8C8880;
}

.quote {
  font-size: 26rpx;
  color: #2C2A26;
  line-height: 1.75;
  padding-left: 22rpx;
  border-left: 4rpx solid #E4DFD5;
  margin-bottom: 18rpx;
  word-break: break-word;
}

.meta {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  font-size: 22rpx;
  color: #8C8880;
  line-height: 1.6;
}

.meta .note {
  color: #B3563C;
}

.meta .link {
  color: #3F7376;
  margin-top: 6rpx;
}

.sig-idle {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 22rpx 26rpx;
  border-radius: 18rpx;
  border: 1rpx solid #E4DFD5;
  background: #FFFFFF;
  font-size: 24rpx;
  color: #4A4842;
}

.sig-idle .idot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #B0ABA2;
  /* 静默态也得有一点动静：它在说「我们还在扫」，不是在说「没数据」 */
  animation: idleScan 2.6s ease-in-out infinite;
}

@keyframes idleScan {
  0%, 100% { opacity: 0.35; transform: scale(0.86); }
  50%      { opacity: 1; transform: scale(1.1); }
}

.sig-idle .b {
  font-weight: 620;
}

.sig-idle .isub {
  font-size: 21rpx;
  color: #8C8880;
  margin-left: auto;
}

/* ---------- 预测 ---------- */

.fc {
  display: flex;
  flex-direction: column;
  gap: 1rpx;
  background: #E4DFD5;
  border: 1rpx solid #E4DFD5;
  border-radius: 20rpx;
  overflow: hidden;
}

.fc-main {
  background: #FFFFFF;
  padding: 30rpx 28rpx;
}

.fc-main .k {
  font-size: 23rpx;
  color: #8C8880;
  letter-spacing: 0.06em;
}

.fc-main .v {
  font-size: 76rpx;
  font-weight: 620;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}

.fc-main .v .u {
  font-size: 26rpx;
  color: #8C8880;
  font-weight: 400;
  margin-left: 8rpx;
}

.fc-main .range {
  font-size: 23rpx;
  color: #4A4842;
  margin-top: 10rpx;
}

.fc-main .range .b {
  font-weight: 620;
  color: #1F1E1B;
  font-variant-numeric: tabular-nums;
}

.fc-bars {
  background: #FFFFFF;
  padding: 26rpx 28rpx 22rpx;
}

.bar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 16rpx;
}

.bar .lb {
  font-size: 22rpx;
  color: #4A4842;
  width: 132rpx;
  flex: none;
}

.bar .track {
  flex: 1;
  height: 14rpx;
  background: #F2EFE8;
  border-radius: 99rpx;
  overflow: hidden;
}

.bar .fill {
  height: 100%;
  background: #3F7376;
  border-radius: 99rpx;
}

.bar .pv {
  font-size: 23rpx;
  font-variant-numeric: tabular-nums;
  width: 104rpx;
  flex: none;
  text-align: right;
}

.cal-tag {
  font-size: 21rpx;
  color: #B3563C;
  margin-top: 6rpx;
}

.fc-meta {
  margin-top: 20rpx;
  padding: 26rpx 28rpx;
}

.fc-block + .fc-block {
  margin-top: 34rpx;
  padding-top: 26rpx;
  border-top: 1rpx solid #E4DFD5;
}

.fc-block .bh {
  font-size: 24rpx;
  font-weight: 620;
  margin-bottom: 16rpx;
}

.row {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #F2EFE8;
}

.row:last-child {
  border-bottom: 0;
}

.row .rk {
  font-size: 23rpx;
  color: #4A4842;
  width: 214rpx;
  flex: none;
}

.row .rv {
  font-size: 25rpx;
  font-variant-numeric: tabular-nums;
  width: 128rpx;
  flex: none;
  font-weight: 600;
}

.row .rv.good {
  color: #3F7376;
}

.row .rv.bad {
  color: #B3563C;
}

.row .rj {
  font-size: 21rpx;
  color: #8C8880;
  flex: 1;
}

.ph {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 0 12rpx;
  padding: 14rpx 0;
  font-size: 22rpx;
}

.ph .pi {
  color: #8C8880;
  width: 96rpx;
  flex: none;
}

/* flex:1 + min-width:0：让日期自己占满剩余宽度，
   而不是给死宽度然后把「2025.09.17 → 2026.04.28」折成两行 */
.ph .pt {
  color: #4A4842;
  font-variant-numeric: tabular-nums;
  flex: 1;
  min-width: 0;
}

.ph .pm {
  font-weight: 620;
  font-variant-numeric: tabular-nums;
  flex: none;
}

/* 样本量与最大间隔另起一行，靠左对齐到日期列 */
.ph .pn {
  width: 100%;
  padding-left: 108rpx;
  color: #8C8880;
  font-size: 21rpx;
}

.bfoot {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #8C8880;
}

/* ---------- 图表 ---------- */

/* canvas 的 height 用 px 写死：canvas 2d 节点是按物理像素建的，
   用 rpx 会随屏幕缩放，导致图内文字与几何比例对不上 */
.chart {
  display: block;
  width: 100%;
}

.chart-survival {
  height: 208px;
}

.chart-strip {
  height: 230px;
}

.legend {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  padding: 4rpx 24rpx 24rpx;
}

.lg {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 21rpx;
  color: #4A4842;
}

.sw {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  display: inline-block;
}

.sw-lan {
  background: #3F7376;
}

.sw-mist {
  background: #8C8880;
}

.sw-cin {
  background: #B3563C;
}

/* ---------- F9 一次性提醒 ---------- */
.remind {
  margin-top: 28rpx;
  padding: 26rpx 28rpx 28rpx;
}

.rd-head {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
}

.rd-t {
  font-size: 29rpx;
  font-weight: 600;
  color: #1F1E1B;
}

.rd-tag {
  margin-left: auto;
  font-size: 20rpx;
  color: #8C8880;
  border: 1rpx solid #E4DFD5;
  border-radius: 99rpx;
  padding: 2rpx 12rpx;
}

.rd-hint {
  margin-top: 10rpx;
  font-size: 23rpx;
  line-height: 1.65;
  color: #8C8880;
}

.rd-btn {
  margin-top: 20rpx;
  padding: 20rpx 0;
  border: 1rpx solid transparent;
  border-radius: 14rpx;
  text-align: center;
  font-size: 27rpx;
  color: #FFFFFF;
  background: #3F7376;
}

.rd-btn.on {
  color: #5F8455;
  background: rgba(95, 132, 85, 0.09);
  border-color: rgba(95, 132, 85, 0.32);
}

.rd-fb {
  margin-top: 14rpx;
  font-size: 22rpx;
  line-height: 1.6;
}

.rd-fb.ok {
  color: #5F8455;
}

.rd-fb.warn {
  color: #B3563C;
}
