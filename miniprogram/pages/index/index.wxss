@keyframes aurora-mint {
  0%, 100% { transform: translate(0, 0) scale(1); }
  50% { transform: translate(48rpx, 33rpx) scale(1.1); }
}

@keyframes aurora-violet {
  0%, 100% { transform: translate(0, 0) scale(1.04); }
  50% { transform: translate(-54rpx, 40rpx) scale(0.96); }
}

@keyframes aurora-blue {
  0%, 100% { transform: translate(0, 0) scale(1); }
  50% { transform: translate(-35rpx, -42rpx) scale(1.08); }
}

@keyframes aurora-orbit {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

@keyframes aurora-date {
  from { opacity: 0; transform: translateY(34rpx) rotateX(-55deg); }
  to { opacity: 1; transform: translateY(0) rotateX(0); }
}

@keyframes aurora-tap {
  from { opacity: 0.7; transform: scale(0.24); }
  to { opacity: 0; transform: scale(1.65); }
}

.motion-on .cloud-mint { animation: aurora-mint 22s ease-in-out infinite; }
.motion-on .cloud-violet { animation: aurora-violet 26s ease-in-out infinite; }
.motion-on .cloud-blue { animation: aurora-blue 31s ease-in-out infinite; }
.motion-on .orbit-orbiter { animation: aurora-orbit 27s linear infinite; }
.motion-on .orbit-inner .orbit-orbiter { animation-duration: 18s; animation-direction: reverse; }
.motion-on .orbit-outer .orbit-orbiter { animation-duration: 42s; animation-direction: reverse; }
.motion-on .eta-digit.entering { animation: aurora-date 0.9s cubic-bezier(0.16, 0.8, 0.25, 1) both; }

/* 页面进入后台时停掉装饰动画；回到前台后由页面生命周期恢复。 */
.motion-off .aurora-cloud,
.motion-off .orbit-orbiter,
.motion-off .tap-ring,
.motion-off .eta-digit,
.motion-off .verdict,
.motion-off .sig-halo,
.motion-off .g-fill,
.motion-off .hero,
.motion-off .pred,
.motion-off .sig,
.motion-off .prog,
.motion-off .detail-area,
.motion-off .foot,
.motion-off .reel .strip,
.motion-off .confidence-fill {
  animation: none !important;
  transition: none !important;
}

.motion-off .prog-reveal,
.motion-off .prog-body,
.motion-off .prog-chevron { transition: none !important; }

.motion-off .eta-digit.entering { opacity: 1; transform: none; }
.motion-off .tap-ring { display: none; }

@media (max-width: 370px) {
  .wrap { padding-left: 24rpx; padding-right: 24rpx; }
  .top .brand { gap: 8rpx; }
  .brand-mark { width: 50rpx; height: 50rpx; border-radius: 15rpx; }
  .top .h1 { font-size: 25rpx; }
  .top .pulse { font-size: 19rpx; }
  .hero { padding: 6rpx 0 8rpx; gap: 4rpx; }
  .counter { font-size: 25rpx; gap: 6rpx; }
  .pred { padding-left: 19rpx; padding-right: 19rpx; }
  .eta-date { font-size: 166rpx; }
  .pred-stage-title { font-size: 23rpx; }
  .pred-stage { min-height: 596rpx; }
  .pcd-row { gap: 5rpx 11rpx; font-size: 49rpx; }
}
