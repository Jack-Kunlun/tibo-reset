  border-radius: 50%;
  transform: translate(-50%, -50%) rotate(-18deg);
}

.orbit-outer { width: 1020rpx; height: 390rpx; opacity: 0.4; }
.orbit-mid { width: 760rpx; height: 290rpx; transform: translate(-50%, -50%) rotate(22deg); opacity: 0.62; }
.orbit-inner { width: 520rpx; height: 198rpx; transform: translate(-50%, -50%) rotate(-16deg); opacity: 0.72; }

.orbit-orbiter {
  position: absolute;
