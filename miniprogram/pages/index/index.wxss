/* 观测台首页样式 —— 与网页端同一套风岚水墨风 */

/* ---------- 滚动计时 ---------- */

.hero {
  text-align: center;
  padding: 56rpx 0 8rpx;
}

.hero .label {
  font-size: 23rpx;
  color: #8C8880;
  letter-spacing: 0.06em;
  margin-bottom: 22rpx;
}

.counter {
  display: flex;
  align-items: baseline;
  justify-content: center;
  flex-wrap: wrap;
  gap: 14rpx;
  font-family: "SF Mono", Menlo, Consolas, monospace;
  font-size: 100rpx;
  font-weight: 600;
  line-height: 1;
  letter-spacing: -0.01em;
}

.grp {
  display: inline-flex;
  align-items: baseline;
}

/* 数字卷轴：外层一格的窗口，内层 0-9 竖排，靠 translateY 滚动 */
.reels {
  display: inline-flex;
  align-items: baseline;
}

.reel {
  display: inline-block;
  width: 0.62em;
  height: 1em;
  overflow: hidden;
  vertical-align: baseline;
}

.reel .strip {
  transition: transform 0.55s cubic-bezier(0.18, 0.86, 0.24, 1);
}

.reel .dg {
  height: 1em;
  line-height: 1;
  text-align: center;
  font-variant-numeric: tabular-nums;
}

.counter .unit {
  font-size: 0.26em;
  color: #8C8880;
  margin-left: 8rpx;
  font-weight: 400;
  font-family: -apple-system, "PingFang SC", sans-serif;
}

.since {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #8C8880;
}

.verdict {
  display: inline-block;
  margin-top: 26rpx;
  font-size: 25rpx;
  padding: 10rpx 26rpx;
  border-radius: 99rpx;
  border: 1rpx solid #E4DFD5;
  background: #F2EFE8;
  color: #4A4842;
}

.verdict .b {
  font-weight: 620;
}

.v-watch {
  border-color: rgba(63, 115, 118, 0.34);
  background: rgba(63, 115, 118, 0.06);
  color: #2F5C5E;
}

.v-long {
  border-color: rgba(179, 86, 60, 0.34);
  background: rgba(179, 86, 60, 0.07);
  color: #8A422E;
}

.v-rare {
  border-color: rgba(179, 86, 60, 0.5);
  background: rgba(179, 86, 60, 0.12);
  color: #7A3421;
}

/* 等待已经偏久时让它轻微呼吸 —— 把结论持续推到眼前，而不是一条静态标签。
   常规区间内不呼吸：那时没什么可提醒的，一直闪反而变成噪音。 */
.verdict.v-long,
.verdict.v-rare {
  animation: breathe 3.2s ease-in-out infinite;
}

@keyframes breathe {
  0%, 100% { box-shadow: 0 0 0 0 rgba(179, 86, 60, 0); }
  50%      { box-shadow: 0 0 0 8rpx rgba(179, 86, 60, 0.09); }
}

/* ---------- 等待进度尺 ---------- */

.gauge {
  margin-top: 26rpx;
  padding: 0 8rpx;
}

.g-track {
  height: 10rpx;
  border-radius: 99rpx;
  background: #EDE9E1;
  overflow: hidden;
}

.g-fill {
  height: 100%;
  border-radius: 99rpx;
  transform-origin: left center;
  /* 从 0 长出来，比直接显示一个静态百分比更有「时间在走」的意味 */
  animation: grow 1.15s cubic-bezier(0.2, 0.75, 0.3, 1) both;
  animation-delay: 0.35s;
}

@keyframes grow {
  from { transform: scaleX(0); }
  to   { transform: scaleX(1); }
}

.g-cool .g-fill { background: linear-gradient(90deg, rgba(95, 132, 85, 0.55), #5F8455); }
.g-warm .g-fill { background: linear-gradient(90deg, rgba(63, 115, 118, 0.55), #3F7376); }
.g-hot  .g-fill { background: linear-gradient(90deg, rgba(179, 86, 60, 0.55), #B3563C); }

.g-text {
  margin-top: 12rpx;
  font-size: 21rpx;
  color: #8C8880;
  text-align: center;
}

.g-hot .g-text {
  color: #8A422E;
}

/* ---------- 进场 ---------- */
/* 让静止的首屏有「依次到位」的顺序感。刻意做得很轻：
   唱主角的是信号横幅，其它区块只是跟着浮现。 */

@keyframes rise {
  from { opacity: 0; transform: translateY(20rpx); }
  to   { opacity: 1; transform: none; }
}

.top,
.pred,
.sig,
.hero,
.metrics,
.fc,
.remind,
.card,
.foot {
  animation: rise 0.55s cubic-bezier(0.2, 0.75, 0.3, 1) both;
}

.top     { animation-delay: 0.02s; }
/* 预测总览排在最前、延迟也最小 —— 入场的先后顺序本身就在说「先看这块」 */
.pred    { animation-delay: 0.04s; }
.sig     { animation-delay: 0.06s; }
.hero    { animation-delay: 0.1s; }
.metrics { animation-delay: 0.16s; }
.fc      { animation-delay: 0.2s; }
.remind  { animation-delay: 0.24s; }
.card    { animation-delay: 0.28s; }
.foot    { animation-delay: 0.32s; }

/* ---------- 第一层：预测总览 ---------- */
/* 这一页曾经是「观察站」：首屏第一块是「每日重置窗口」（规则），第二块是「有没有公告」，
   大计数器排在第三块 —— **没有一块在回答「下一次什么时候」**。
   现在结论单独成层，放在 `.top` 下面第一个，也是全页视觉重量最大的一块。

   ── 主次怎么拉开的 ──────────────────────────────────────────────
   全靠**这一处**：更白的底、更大的圆角、唯一的顶边状态色。不靠到处加装饰。
   它比 `.sig`（引用/公告）重，比 `.prog`（规则）重得多 —— `.prog` 是 `#F2EFE8` 的浅底。

   ── 状态色系统（与网页端同一套 token，见 src/index.html 的 :root）──────
     已确认 confirmed  竹青 #5F8455
     高概率 likely     岚青 #3F7376
     观察中 watching   雾   #8C8880
   状态说「依据从哪来」，置信度说「这个来源值多少分」—— 两个轴，两处着色。

   ⚠ 类名前缀是 `pred-` / `pcd-` / `pe-` / `pf-` / `pb-`，刻意避开既有的
     `.ph .pm`（节奏分段里的数值）与 `.pc-*`（网页端主卡）。同族冲突要靠前缀隔开：
     用一个已经存在的词，症状会是「某处的数字凭空长出圆角盒子」，
     而 CSS 里根本找不到谁给它加的 —— 网页端实测踩过一次。 */

.pred {
  margin-top: 28rpx;
  padding: 30rpx 28rpx 26rpx;
  border-radius: 24rpx;
  border: 1rpx solid #E4DFD5;
  /* 顶边那道状态色是这一页唯一的「状态色前缀」，比左侧色条更醒目 */
  border-top: 6rpx solid #8C8880;
  background:
    radial-gradient(130% 80% at 0% 0%, rgba(63, 115, 118, 0.07), rgba(255, 255, 255, 0) 58%),
    #FFFFFF;
}

.pred[data-status="confirmed"] { border-top-color: #5F8455; }
.pred[data-status="likely"]    { border-top-color: #3F7376; }
.pred[data-status="watching"]  { border-top-color: #8C8880; }

.pred-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-wrap: wrap;
  margin-bottom: 12rpx;
}

.pred-t {
  font-size: 30rpx;
  font-weight: 650;
  color: #1F1E1B;
}

.pred-badge {
  padding: 4rpx 16rpx;
  border-radius: 99rpx;
  font-size: 21rpx;
  letter-spacing: 0.08em;
  color: #FFFFFF;
  background: #8C8880;
}

.pred[data-status="confirmed"] .pred-badge { background: #5F8455; }
.pred[data-status="likely"]    .pred-badge { background: #3F7376; }

.pred-note {
  font-size: 22rpx;
  color: #8C8880;
  line-height: 1.55;
}

/* 预计时间：日期是最大的字，星期与时刻退到副行。
   用户从「10 月 8 日 周四 15:00」里最先抓住的是日期本身。 */
.pred-eta {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  flex-wrap: wrap;
  margin-top: 22rpx;
}

.pe-md {
  font-family: "SF Mono", Menlo, Consolas, monospace;
  font-size: 76rpx;
  font-weight: 300;
  line-height: 1;
  letter-spacing: -0.02em;
  color: #1F1E1B;
}

.pe-rest {
  font-family: "SF Mono", Menlo, Consolas, monospace;
  font-size: 32rpx;
  color: #4A4842;
}

/* 大倒计时。这是全页**唯一**往前看的读数（信号区那个「距窗口开启」的倒数
   在公告档下与它同锚点、同值，已一并去掉）。没有公告时它是首屏唯一的时间锚点。 */
.pred-cd {
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #E4DFD5;
}

.pcd-cap {
  display: block;
  font-size: 22rpx;
  letter-spacing: 0.12em;
  color: #8C8880;
}

.pcd-row {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 18rpx;
  margin: 12rpx 0 4rpx;
  font-family: "SF Mono", Menlo, Consolas, monospace;
  font-size: 64rpx;
  font-weight: 600;
  line-height: 1.05;
  color: #1F1E1B;
  font-variant-numeric: tabular-nums;
}

.pcd-g {
  display: inline-flex;
  align-items: baseline;
}

.pcd-u {
  font-size: 22rpx;
  font-weight: 400;
  color: #8C8880;
  margin-left: 6rpx;
  font-family: -apple-system, "PingFang SC", sans-serif;
}

/* 过了预测时刻就不再报读数，只报状态 —— 与网页端 `.pc-wait[data-over]` 同一口径 */
.pred-cd.is-over .pcd-row {
  font-size: 34rpx;
  color: #B3563C;
}

.pred-band {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-top: 12rpx;
}

.pb-k {
  font-size: 22rpx;
  color: #8C8880;
}

.pb-v {
  font-family: "SF Mono", Menlo, Consolas, monospace;
  font-size: 25rpx;
  color: #4A4842;
  font-variant-numeric: tabular-nums;
}

.pred-brief {
  margin-top: 20rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #4A4842;
}

.pred-foot {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #E4DFD5;
  font-size: 22rpx;
  color: #8C8880;
}

.pf-k {
  letter-spacing: 0.06em;
}

.pf-v {
  font-size: 28rpx;
  font-weight: 620;
  color: #1F1E1B;
}

.pred[data-level="high"]   .pf-v { color: #5F8455; }
.pred[data-level="medium"] .pf-v { color: #3F7376; }

/* 置信度强度条。**刻意不用网页端那三个小格**：手机宽度下 3 格各只有几像素，
   读起来是三个点而不是一个量。改成一条按档位填充的横条 ——
   同一个意思（填充越多越可信），在窄屏上更读得出来。 */
.pf-bar {
  flex: 1 1 120rpx;
  min-width: 90rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #E4DFD5;
  overflow: hidden;
}

.pf-fill {
  height: 100%;
  border-radius: 4rpx;
  background: #8C8880;
  transition: width 0.4s cubic-bezier(0.2, 0.75, 0.3, 1);
}

.pred[data-level="high"]   .pf-fill { background: #5F8455; }
.pred[data-level="medium"] .pf-fill { background: #3F7376; }

/* 「预测算于 …」单独起一行：它是**元信息**，跟置信度挤在同一行会被当成置信度的一部分 */
.pf-upd {
  flex-basis: 100%;
  font-size: 21rpx;
  color: #8C8880;
}

/* ---------- 信号横幅 ---------- */
/* 有信号时这里是全页视觉重量最大的块。做法是「晕染 + 大字 + 呼吸」，
   而不是换成深色底 —— 深色底会和整站的水墨宣纸基调打架。 */

.sig {
  position: relative;
  overflow: hidden;
  margin-top: 28rpx;
  padding: 28rpx 28rpx 24rpx;
  border-radius: 22rpx;
  border: 1rpx solid rgba(179, 86, 60, 0.34);
  border-left: 8rpx solid #B3563C;
  background:
    radial-gradient(120% 88% at 0% 0%, rgba(179, 86, 60, 0.15), rgba(179, 86, 60, 0.03) 62%, rgba(255, 255, 255, 0) 100%),
    #FFFFFF;
}

.sig[data-level="hint"] {
  border-color: rgba(63, 115, 118, 0.3);
  border-left-color: #3F7376;
  background:
    radial-gradient(120% 88% at 0% 0%, rgba(63, 115, 118, 0.14), rgba(63, 115, 118, 0.03) 62%, rgba(255, 255, 255, 0) 100%),
    #FFFFFF;
}

/* 呼吸光斑：让「有信号」这件事一直可见，而不是静着一张卡片 */
.sig-halo {
  position: absolute;
  top: -70rpx;
  left: -70rpx;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(179, 86, 60, 0.3), rgba(179, 86, 60, 0) 70%);
  animation: halo 3.8s ease-in-out infinite;
}

.sig[data-level="hint"] .sig-halo {
  background: radial-gradient(circle, rgba(63, 115, 118, 0.28), rgba(63, 115, 118, 0) 70%);
}

@keyframes halo {
  0%, 100% { opacity: 0.4; transform: scale(1); }
  50%      { opacity: 0.95; transform: scale(1.16); }
}

.sig-head {
  position: relative;
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.badge {
  font-size: 21rpx;
  letter-spacing: 0.08em;
  padding: 5rpx 18rpx;
  border-radius: 99rpx;
  background: #B3563C;
  color: #FFFFFF;
}

/* 徽章上的活点：与光斑同频，暗示「还在扫」 */
.badge .bdot {
  display: inline-block;
  width: 10rpx;
  height: 10rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: #FFFFFF;
  animation: halo 1.9s ease-in-out infinite;
}

.sig[data-level="hint"] .badge {
  background: #3F7376;
}

.sig-title {
  font-size: 30rpx;
  font-weight: 650;
  flex: 1;
}

/* ---------- 大字公告 ---------- */
/* 人从「Tibo 说下周二重置」里最先抓住的就是那个星期 —— 它该是最大的字 */

.ann {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 14rpx 0 22rpx;
}

.ann-cap {
  font-size: 21rpx;
  color: #8C8880;
  letter-spacing: 0.16em;
}

.ann-big {
  font-size: 100rpx;
  font-weight: 700;
  line-height: 1.12;
  letter-spacing: 0.04em;
  color: #B3563C;
}

.sig[data-level="hint"] .ann-big {
  color: #3F7376;
}

.ann-sub {
  font-size: 24rpx;
  color: #4A4842;
  font-variant-numeric: tabular-nums;
}

.wprec {
  display: block;
  padding: 12rpx 20rpx 14rpx;
  font-size: 21rpx;
  color: #8C8880;
}

.win {
  border: 1rpx solid #E4DFD5;
  border-radius: 14rpx;
  overflow: hidden;
  background: #FFFFFF;
  margin-bottom: 20rpx;
}

.wrow {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  padding: 16rpx 20rpx;
  border-bottom: 1rpx solid #E4DFD5;
}

.wrow .k {
  font-size: 22rpx;
  color: #8C8880;
  width: 176rpx;
  flex: none;
}

.wrow .v {
  font-size: 27rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  flex: 1;
  /* 换行位置由数据层显式给出：view.js 的 breakBeforeTime 会在「日期 / 时间」之间插 `\n`。
     原因见那里的注释 —— 402pt 真机上整串放不下，而它**唯一的空格在 `15:00` 后**，
     断在那里会把「起」挤成孤零零一行。pre-line 让那个 `\n` 真的生效
     （text 组件默认不把 `\n` 当换行，必须显式声明）。 */
  white-space: pre-line;
  /* 兜底：拿到没有 `\n` 的值时（形态变了）也别在汉字中间断。
     keep-all 把断点限制到空格处，break-word 防止长串溢出。 */
  word-break: keep-all;
  overflow-wrap: break-word;
}

.wrow .z {
  font-size: 21rpx;
  color: #8C8880;
  /* 时区名不许被压窄、也不许内部断行。
     默认 flex-shrink:1 会把它压到放不下，`UTC+8` 就有断成两行的风险；
     它是这一行里最不该牺牲的信息（值可以折行，时区不能拆）。 */
  flex: none;
  white-space: nowrap;
}

.wfoot {
  padding: 14rpx 20rpx;
  font-size: 22rpx;
  color: #8C8880;
}

.quote {
  font-size: 26rpx;
  color: #2C2A26;
  line-height: 1.75;
  padding-left: 22rpx;
  border-left: 4rpx solid #E4DFD5;
  margin-bottom: 18rpx;
  word-break: break-word;
}

/* 与上方拉开一段距离。
   上面要么是 `.ev`（灰底框，框底边紧贴它最后一行文字），要么是 `.quote`；
   两者原本的间距只有框内 padding 那点余量 —— 真机实测 15.5px，
   「判定依据」这行灰字看着就贴在灰框底边上。 */
.meta {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  font-size: 22rpx;
  color: #8C8880;
  line-height: 1.6;
}

.meta .note {
  color: #B3563C;
}

.meta .link {
  color: #3F7376;
  margin-top: 6rpx;
}

/* 综合证据摘要：虚线框 + 灰底，视觉上明确「这是复核材料，不是结论」。
   和网页端的样子保持一致，两端看同一份数据应当有同一套语义。 */
/* 预告依据的推文：一条预告 = 一个时间窗口，支撑它的推文就列在这条里面（见 D-018）。
   默认收起 —— 手机一屏放不下「窗口 + 4 条推文 + 倒计时」，而倒计时是这一页的主角。 */
.ev {
  margin-top: 20rpx;
  border: 1rpx solid rgba(140, 136, 128, 0.28);
  border-radius: 14rpx;
  background: #F2EFE8;
  overflow: hidden;
}

.ev-head {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 14rpx;
  padding: 16rpx 20rpx;
}

.ev-t {
  font-size: 23rpx;
  color: #1F1E1B;
  font-weight: 600;
}

.ev-mix {
  font-size: 21rpx;
  color: #8C8880;
}

.ev-toggle {
  margin-left: auto;
  font-size: 21rpx;
  color: #3F7376;
}

.ev-body {
  padding: 0 20rpx 18rpx;
  border-top: 1rpx solid rgba(140, 136, 128, 0.28);
}

.ev-note {
  display: block;
  padding-top: 14rpx;
  font-size: 21rpx;
  color: #8C8880;
  line-height: 1.6;
}

.ev-item {
  margin-top: 16rpx;
  padding-left: 16rpx;
  border-left: 4rpx solid rgba(140, 136, 128, 0.5);
}

.ev-item.hard {
  border-left-color: #3F7376;
}

.ev-top {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  font-size: 21rpx;
  color: #8C8880;
}

.ev-when {
  font-family: monospace;
}

.ev-tag {
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(140, 136, 128, 0.16);
  color: #8C8880;
  font-size: 20rpx;
}

.ev-tag.hard {
  background: rgba(63, 115, 118, 0.14);
  color: #3F7376;
}

.ev-via {
  color: #4A4842;
}

.ev-word {
  font-family: monospace;
  color: #4A4842;
}

.ev-quote {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #4A4842;
  line-height: 1.6;
}

.ev-link {
  display: inline-block;
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #3F7376;
}

.sig-idle {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 22rpx 26rpx;
  border-radius: 18rpx;
  border: 1rpx solid #E4DFD5;
  background: #FFFFFF;
  font-size: 24rpx;
  color: #4A4842;
}

.sig-idle .idot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #B0ABA2;
  /* 静默态也得有一点动静：它在说「我们还在扫」，不是在说「没数据」 */
  animation: idleScan 2.6s ease-in-out infinite;
}

@keyframes idleScan {
  0%, 100% { opacity: 0.35; transform: scale(0.86); }
  50%      { opacity: 1; transform: scale(1.1); }
}

.sig-idle .b {
  font-weight: 620;
}

.sig-idle .isub {
  font-size: 21rpx;
  color: #8C8880;
  margin-left: auto;
}

/* ---------- 每日重置窗口（跨多日的持续规则，不是某一天的预告） ---------- */
/* 视觉上刻意比 .sig 轻：预告才是这一区的主角，这条是补充事实。
   左边那道 4rpx 岚青是唯一的强调，用来和下面那片白卡片区分开。
   窗口块直接复用 .win / .wrow / .wfoot —— 它们是顶层类名，不受 .sig 作用域限制，
   同一种形状（当地 + 北京两行）没有理由再画一遍。 */
/* 上边距不能省：`.top` 自带 1rpx 下边框（见 app.wxss），而 `.top` 下面那几块
   彼此之间只差 0rpx 的间隔时，两条 1rpx 会叠成一条。取值 28rpx 与
   `.pred` / `.sig-idle` / `.sig` 一致 —— 端上这几块本来就是同一个数。
   ⚠ `2026-10-08` 起 `.top` 下面**第一个**元素已经不是 `.prog` 而是 `.pred`
   （预测总览提到首屏第一块），但这条规则与 `.prog` 在不在第一位无关：
   它管的是「相邻块之间不贴线」，所以取值仍然要对齐同族。 */
.prog {
  margin: 28rpx 0 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 18rpx;
  border: 1rpx solid #E4DFD5;
  border-left: 4rpx solid #3F7376;
  background: #F2EFE8;
}

.prog-head {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.prog-tag {
  font-size: 22rpx;
  font-weight: 620;
  color: #3F7376;
  letter-spacing: 1rpx;
}

.prog-left {
  margin-left: auto;
  font-size: 22rpx;
  color: #8C8880;
}

.prog-left .n {
  color: #4A4842;
  font-weight: 620;
}

.prog-rule {
  display: block;
  font-size: 25rpx;
  line-height: 1.6;
  color: #4A4842;
  margin-bottom: 16rpx;
}

.prog-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 12rpx;
  font-size: 21rpx;
  color: #8C8880;
}

.prog-link {
  color: #3F7376;
  border-bottom: 1rpx dotted #3F7376;
}

/* ---------- 预测 ---------- */

.fc {
  display: flex;
  flex-direction: column;
  gap: 1rpx;
  background: #E4DFD5;
  border: 1rpx solid #E4DFD5;
  border-radius: 20rpx;
  overflow: hidden;
}

.fc-main {
  background: #FFFFFF;
  padding: 30rpx 28rpx;
}

.fc-main .k {
  font-size: 23rpx;
  color: #8C8880;
  letter-spacing: 0.06em;
}

.fc-main .v {
  font-size: 76rpx;
  font-weight: 620;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}

.fc-main .v .u {
  font-size: 26rpx;
  color: #8C8880;
  font-weight: 400;
  margin-left: 8rpx;
}

.fc-main .range {
  font-size: 23rpx;
  color: #4A4842;
  margin-top: 10rpx;
}

.fc-main .range .b {
  font-weight: 620;
  color: #1F1E1B;
  font-variant-numeric: tabular-nums;
}

.fc-bars {
  background: #FFFFFF;
  padding: 26rpx 28rpx 22rpx;
}

.bar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 16rpx;
}

.bar .lb {
  font-size: 22rpx;
  color: #4A4842;
  width: 132rpx;
  flex: none;
}

.bar .track {
  flex: 1;
  height: 14rpx;
  background: #F2EFE8;
  border-radius: 99rpx;
  overflow: hidden;
}

.bar .fill {
  height: 100%;
  background: #3F7376;
  border-radius: 99rpx;
}

.bar .pv {
  font-size: 23rpx;
  font-variant-numeric: tabular-nums;
  width: 104rpx;
  flex: none;
  text-align: right;
}

.cal-tag {
  font-size: 21rpx;
  color: #B3563C;
  margin-top: 6rpx;
}

.fc-meta {
  margin-top: 20rpx;
  padding: 26rpx 28rpx;
}

.fc-block + .fc-block {
  margin-top: 34rpx;
  padding-top: 26rpx;
  border-top: 1rpx solid #E4DFD5;
}

.fc-block .bh {
  font-size: 24rpx;
  font-weight: 620;
  margin-bottom: 16rpx;
}

.row {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #F2EFE8;
}

.row:last-child {
  border-bottom: 0;
}

.row .rk {
  font-size: 23rpx;
  color: #4A4842;
  width: 214rpx;
  flex: none;
}

.row .rv {
  font-size: 25rpx;
  font-variant-numeric: tabular-nums;
  width: 128rpx;
  flex: none;
  font-weight: 600;
}

.row .rv.good {
  color: #3F7376;
}

.row .rv.bad {
  color: #B3563C;
}

.row .rj {
  font-size: 21rpx;
  color: #8C8880;
  flex: 1;
}

.ph {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 0 12rpx;
  padding: 14rpx 0;
  font-size: 22rpx;
}

.ph .pi {
  color: #8C8880;
  width: 96rpx;
  flex: none;
}

/* flex:1 + min-width:0：让日期自己占满剩余宽度，
   而不是给死宽度然后把「2025.09.17 → 2026.04.28」折成两行 */
.ph .pt {
  color: #4A4842;
  font-variant-numeric: tabular-nums;
  flex: 1;
  min-width: 0;
}

.ph .pm {
  font-weight: 620;
  font-variant-numeric: tabular-nums;
  flex: none;
}

/* 样本量与最大间隔另起一行，靠左对齐到日期列 */
.ph .pn {
  width: 100%;
  padding-left: 108rpx;
  color: #8C8880;
  font-size: 21rpx;
}

.bfoot {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #8C8880;
}

/* ---------- 图表 ---------- */

/* canvas 的 height 用 px 写死：canvas 2d 节点是按物理像素建的，
   用 rpx 会随屏幕缩放，导致图内文字与几何比例对不上 */
.chart {
  display: block;
  width: 100%;
}

.chart-survival {
  height: 208px;
}

/* 与 scene.js 的 `compactLayout.histHeight = 186` 对齐 ——
   canvas 高度必须 ≥ 场景高度，否则底部那行档位标签会被裁掉。 */
.chart-hist {
  height: 190px;
}

.chart-strip {
  height: 230px;
}

.legend {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  padding: 4rpx 24rpx 24rpx;
}

.lg {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 21rpx;
  color: #4A4842;
}

.sw {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  display: inline-block;
}

.sw-lan {
  background: #3F7376;
}

.sw-mist {
  background: #8C8880;
}

.sw-cin {
  background: #B3563C;
}

/* ---------- F9 一次性提醒 ---------- */
.remind {
  margin-top: 28rpx;
  padding: 26rpx 28rpx 28rpx;
}

.rd-head {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
}

.rd-t {
  font-size: 29rpx;
  font-weight: 600;
  color: #1F1E1B;
}

.rd-tag {
  margin-left: auto;
  font-size: 20rpx;
  color: #8C8880;
  border: 1rpx solid #E4DFD5;
  border-radius: 99rpx;
  padding: 2rpx 12rpx;
}

.rd-hint {
  margin-top: 10rpx;
  font-size: 23rpx;
  line-height: 1.65;
  color: #8C8880;
}

.rd-btn {
  margin-top: 20rpx;
  padding: 20rpx 0;
  border: 1rpx solid transparent;
  border-radius: 14rpx;
  text-align: center;
  font-size: 27rpx;
  color: #FFFFFF;
  background: #3F7376;
}

.rd-btn.on {
  color: #5F8455;
  background: rgba(95, 132, 85, 0.09);
  border-color: rgba(95, 132, 85, 0.32);
}

.rd-fb {
  margin-top: 14rpx;
  font-size: 22rpx;
  line-height: 1.6;
}

.rd-fb.ok {
  color: #5F8455;
}

.rd-fb.warn {
  color: #B3563C;
}
