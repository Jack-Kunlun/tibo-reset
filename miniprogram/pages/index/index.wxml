<!-- 极光观测台：经过时长 → 下一次预测 → 信号 → 每日窗口 → 依据 → 节奏与记录。 -->
<view class="wrap {{singlePage ? 'sp' : ''}} {{motionEnabled && pageVisible ? 'motion-on' : 'motion-off'}}">
  <view class="aurora-sky" aria-hidden="true">
    <view class="aurora-cloud cloud-mint"></view>
    <view class="aurora-cloud cloud-violet"></view>
    <view class="aurora-cloud cloud-blue"></view>
  </view>

  <view class="page-content">
    <view class="top" style="padding-top:{{nav.statusBarHeight}}px">
      <view class="brand-line" style="min-height:{{nav.brandHeight}}px;padding-right:{{nav.capsuleReserve}}px">
        <view class="brand">
          <view class="brand-mark"><view class="brand-core"></view></view>
          <view class="brand-copy">
            <text class="h1">等 TIBO 按按钮</text>
            <text class="sub">RESET OBSERVATORY</text>
          </view>
        </view>
      </view>
      <view class="top-tools">
        <view class="pulse {{degraded ? 'warn' : ''}}">
          <text class="dot"></text>
          <text>{{updText}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{notice}}" class="notice">{{notice}}</view>

    <!-- 已经过去的时间是事实，使用紧凑卷轴放在预测之前。 -->
    <view class="hero" id="elapsed">
      <view class="elapsed-line">
        <text class="label">距上次重置</text>
        <view class="counter">
          <view class="grp" wx:for="{{counter}}" wx:key="unit" wx:for-item="g">
            <view class="reels">
              <view class="reel" wx:for="{{g.digits}}" wx:key="index" wx:for-item="d">
                <view class="strip" style="transform: translateY(-{{d}}em)">
                  <view class="dg" wx:for="{{digits}}" wx:key="*this" wx:for-item="n">{{n}}</view>
                </view>
              </view>
            </view>
            <text class="unit">{{g.unit}}</text>
          </view>
        </view>
      </view>
      <text class="since">{{since}}</text>
    </view>

    <!-- 预测是视觉主卡。日期、倒计时与区间均来自 outlook 视图模型。 -->
    <view
      wx:if="{{pred}}"
      id="forecast"
      class="pred {{pred.statusClass}} {{pred.confidenceClass}}"
      data-status="{{pred.status}}"
      data-level="{{pred.confidence}}"
      bindtouchstart="onHeroTouch"
    >
      <view class="orbit-field" aria-hidden="true">
        <view class="orbit-plane orbit-outer"><view class="orbit-orbiter"><view class="orbit-dot"></view></view></view>
        <view class="orbit-plane orbit-mid"><view class="orbit-orbiter"><view class="orbit-dot"></view></view></view>
        <view class="orbit-plane orbit-inner"><view class="orbit-orbiter"><view class="orbit-dot"></view></view></view>
        <view class="stage-glow"></view>
        <view class="star star-a"></view>
        <view class="star star-b"></view>
        <view class="star star-c"></view>
        <view class="star star-d"></view>
      </view>
      <view wx:if="{{ripple.show}}" class="tap-ring" style="left:{{ripple.x}}px;top:{{ripple.y}}px"></view>

      <view class="pred-content">
        <view class="pred-head">
          <text class="pred-t">NEXT RESET</text>
          <text class="pred-badge">置信度 · {{pred.confidenceLabel}}</text>
        </view>

        <view class="pred-stage">
          <text class="pred-stage-title">下一次重置预测</text>
          <view class="eta-date" aria-label="预测日期 {{pred.md}}">
            <text
              wx:for="{{pred.dateDigits}}"
              wx:key="key"
              wx:for-item="digit"
              class="eta-digit {{digit.value === '.' ? 'eta-digit-dot' : ''}} {{entering && pageVisible ? 'entering' : ''}}"
              style="animation-delay:{{digit.delay}}"
            >{{digit.value}}</text>
          </view>
          <text class="eta-detail">{{pred.etaDetail}}</text>
          <view class="pred-countdown {{pred.cd.over ? 'is-over' : ''}}">
            <text class="pcd-cap">{{pred.cd.over ? pred.cd.label : '预计还需等待'}}</text>
            <view class="pcd-row">
              <view class="pcd-g" wx:for="{{pred.cd.groups}}" wx:key="unit">
                <text class="pcd-v">{{item.v}}</text>
                <text class="pcd-u">{{item.unit}}</text>
              </view>
            </view>
          </view>
        </view>

        <view wx:if="{{pred.band}}" class="pred-range">
          <text class="range-label">{{pred.etaKind === 'announced' ? '公告窗口' : '80% 预测区间'}}</text>
          <text class="range-value">{{pred.band}}</text>
        </view>
      </view>
    </view>

    <!-- 信号紧贴预测；没发现预告时也明确展示扫描结论。 -->
    <view wx:if="{{signal.show}}" class="sig sig-{{signal.level}}" data-level="{{signal.level}}" bindtap="onToggleSignalDetails">
      <view class="signal-dot"></view>
      <text class="signal-badge">{{signal.badge}}</text>
      <text class="signal-title">{{signal.title}}</text>
      <text wx:if="{{signal.evCount}}" class="signal-count">{{signal.evCount}} 条依据 ›</text>
      <text wx:else class="signal-count">查看线索 ›</text>
    </view>
    <view wx:else class="sig-idle" bindtap="onIdleTap">
      <view class="idle-ico"></view>
      <view class="idle-body">
        <text class="idle-t">最近 <text class="b">{{signal.checked}}</text> 条推文中没有检测到重置预告</text>
        <text wx:if="{{signal.windowFrom}}" class="idle-sub">时间窗自 {{signal.windowFrom}} 起</text>
      </view>
      <text class="idle-go">›</text>
    </view>

    <view wx:if="{{signal.show && signalDetailsOpen}}" class="signal-detail">
      <view wx:if="{{signal.window}}" class="win">
        <view class="wrow"><text class="k">Tibo 当地时间</text><text class="v">{{signal.window.sourceZone}}</text><text class="z">{{signal.window.srcOffset}}</text></view>
        <view class="wrow"><text class="k">北京时间</text><text class="v">{{signal.window.userZone}}</text><text class="z">{{signal.window.usrOffset}}</text></view>
        <text class="wfoot">{{signal.window.diffText}}{{signal.window.rangeNote ? ' · ' + signal.window.rangeNote : ''}}</text>
        <text wx:if="{{signal.precision}}" class="wprec">粒度：{{signal.precision}}</text>
      </view>
      <view wx:if="{{signal.evCount}}" class="ev">
        <text wx:if="{{signal.evNote}}" class="ev-note">{{signal.evNote}}</text>
        <view wx:for="{{signal.ev}}" wx:key="id" class="ev-item {{item.weight === 'hard' ? 'hard' : ''}}">
          <view class="ev-top">
            <text class="ev-when">{{item.when}} 北京</text>
            <text class="ev-tag {{item.weight}}">{{item.tag}}</text>
            <text wx:if="{{item.via}}" class="ev-via">{{item.via}}</text>
            <text wx:if="{{item.word}}" class="ev-word">{{item.word}}</text>
          </view>
          <text class="ev-quote">{{item.text}}</text>
          <text wx:if="{{item.url && !singlePage}}" class="ev-link" data-url="{{item.url}}" bindtap="onCopySource">复制原推链接</text>
        </view>
      </view>
      <text wx:if="{{!signal.evCount}}" class="quote">{{signal.text}}</text>
      <view class="meta">
        <text wx:if="{{signal.createdText}}">发布于 {{signal.createdText}}</text>
        <text wx:if="{{signal.timeNote}}" class="note">{{signal.timeNote}}</text>
        <text wx:if="{{signal.reason}}">判定依据：{{signal.reason}}</text>
        <text wx:if="{{signal.url && !signal.evCount && !singlePage}}" class="link" data-url="{{signal.url}}" bindtap="onCopySource">复制原推链接</text>
      </view>
    </view>

    <!-- 每日计划与某一天的预告分开呈现，默认收起，只在需要时查看时区和来源。 -->
    <view wx:if="{{signal.program.show}}" class="prog">
      <view class="prog-head" bindtap="onToggleProgram">
        <view class="program-icon"><text>28</text></view>
        <view class="program-copy">
          <text class="prog-tag">每日重置窗口</text>
          <text class="prog-left">共 {{signal.program.days}} 天 · 还剩 {{signal.program.daysLeft}} 天</text>
        </view>
        <text class="prog-toggle">{{programOpen ? '−' : '＋'}}</text>
      </view>
      <view wx:if="{{programOpen}}" class="prog-body">
        <text class="prog-rule">每天要么发一个改进、要么给一次完整重置 —— 期间任何一天都可能重置</text>
        <view wx:if="{{signal.program.window}}" class="win">
          <view class="wrow">
            <text class="k">Tibo 当地时间</text>
            <text class="v">{{signal.program.window.sourceZone}}</text>
            <text class="z">{{signal.program.window.srcOffset}}</text>
          </view>
          <view class="wrow">
            <text class="k">北京时间</text>
            <text class="v">{{signal.program.window.userZone}}</text>
            <text class="z">{{signal.program.window.usrOffset}}</text>
          </view>
          <text class="wfoot">{{signal.program.window.diffText}}{{signal.program.window.rangeNote ? ' · ' + signal.program.window.rangeNote : ''}}</text>
        </view>
        <view class="prog-meta">
          <text wx:if="{{signal.program.announcedText}}">发布于 {{signal.program.announcedText}}</text>
          <text wx:if="{{signal.program.url && !singlePage}}" class="prog-link" data-url="{{signal.program.url}}" bindtap="onCopySource">复制原推链接</text>
        </view>
      </view>
    </view>

    <!-- 三行数据依据都来自当前预测、历史节奏与样本外回测。 -->
    <view wx:if="{{basisRows.length}}" class="basis card">
      <view class="section-head">
        <text class="section-title">预测依据</text>
      </view>
      <view class="basis-row" wx:for="{{basisRows}}" wx:key="key">
        <text class="basis-key">{{item.label}}</text>
        <view class="basis-value" aria-label="{{item.value}}">
          <text wx:for="{{item.parts}}" wx:for-item="part" wx:key="key" class="{{part.numeric ? 'basis-number' : 'basis-unit'}}">{{part.text}}</text>
        </view>
      </view>
    </view>

    <!-- 最近七段已完成间隔，当前未完成的等待不混进历史样本。 -->
    <view class="trend-panel card">
      <view class="section-head">
        <text class="section-title">历史节奏</text>
        <text class="section-sub">最近 {{trendCount}} 次完整间隔</text>
      </view>
      <canvas type="2d" id="trend" class="trend-chart"></canvas>
      <view wx:if="{{trendCount}}" class="trend-caption">
        <text>{{trendFirst}}</text>
        <text>间隔天数</text>
        <text>{{trendLast}}</text>
      </view>
    </view>

    <view class="records card">
      <view class="section-head">
        <text class="section-title">最近记录</text>
        <text class="section-sub">{{survivalN}} 次历史间隔</text>
      </view>
      <view class="record-row" wx:for="{{recentRecords}}" wx:key="key">
        <view class="record-top">
          <text class="record-date">{{item.date}}</text>
          <text class="record-type {{item.type === '发券型' ? 'credit' : ''}}">{{item.type}}</text>
        </view>
        <text class="record-text">{{item.text}}</text>
        <text wx:if="{{item.url && !singlePage}}" class="record-link" data-url="{{item.url}}" bindtap="onCopySource">复制原推链接</text>
      </view>
      <view wx:if="{{moreRecordsCount}}" class="more-records-toggle" bindtap="onToggleMoreRecords">
        <text>{{moreRecordsOpen ? '收起较早记录' : '再看 ' + moreRecordsCount + ' 条'}}</text>
        <text>{{moreRecordsOpen ? '−' : '＋'}}</text>
      </view>
      <view wx:if="{{moreRecordsOpen}}" class="more-records">
        <view class="record-row" wx:for="{{moreRecords}}" wx:key="key">
          <view class="record-top">
            <text class="record-date">{{item.date}}</text>
            <text class="record-type {{item.type === '发券型' ? 'credit' : ''}}">{{item.type}}</text>
          </view>
          <text class="record-text">{{item.text}}</text>
          <text wx:if="{{item.url && !singlePage}}" class="record-link" data-url="{{item.url}}" bindtap="onCopySource">复制原推链接</text>
        </view>
      </view>
      <navigator wx:if="{{!singlePage}}" class="history-link" url="/pages/history/index" open-type="navigate">查看完整历史记录 →</navigator>
    </view>

    <view class="detail-toggle" bindtap="onToggleDetails">
      <text>{{detailsOpen ? '收起详细观测数据' : '展开回测、历史图与统计'}}</text>
      <text class="detail-arrow">{{detailsOpen ? '−' : '＋'}}</text>
    </view>

    <!-- 完整回测、概率分布、历史三图与样本统计保留在展开区。 -->
    <view wx:if="{{detailsOpen}}" class="detail-area">
      <view class="prediction-disclosure card">
        <view class="section-head"><text class="section-title">预测说明</text></view>
        <text class="disclosure-line">等待状态：{{verdict.text}} · {{verdict.tail}}</text>
        <text class="disclosure-line">{{pred.statusLabel}} · {{pred.statusNote}}</text>
        <text class="disclosure-line">预测算于 {{pred.updatedText}}</text>
        <text class="disclosure-line">{{pred.brief}}</text>
      </view>
      <block wx:if="{{forecast}}">
        <view class="section-head detail-heading">
          <text class="section-title">模型侧辅助数据</text>
          <text class="section-sub">{{forecast.hint}}</text>
        </view>
        <view class="bc-grid">
          <view class="bc" data-bc="wait">
            <view class="bc-h"><view class="ico ico-wait"></view><text class="bc-t">中位剩余等待</text></view>
            <view class="bc-num"><text class="b">{{forecast.wait.num}}</text><text class="u">{{forecast.wait.unit}}</text></view>
            <view class="bc-range">{{forecast.wait.range}}</view>
            <view class="bc-bar" wx:for="{{forecast.wait.bars}}" wx:key="label">
              <text class="lb">{{item.label}}</text>
              <view class="track"><view class="fill" style="width:{{item.w}}%"></view></view>
              <text class="pv">{{item.pv}}</text>
            </view>
            <view class="bc-note is-warn">{{forecast.wait.warn}}</view>
          </view>
          <view class="bc" data-bc="backtest">
            <view class="bc-h"><view class="ico ico-bars"></view><text class="bc-t">样本外回测</text></view>
            <view class="bc-sub">n = {{forecast.backtest.n}}（阈值 ≥ {{forecast.backtest.minN}}）</view>
            <view class="bc-row" wx:for="{{forecast.backtest.rows}}" wx:key="k">
              <text class="k">{{item.k}}</text><text class="v {{item.ok ? 'good' : 'bad'}}">{{item.v}}</text><text class="j">{{item.j}}</text>
            </view>
            <view class="bc-note" data-note="backtest">{{forecast.backtest.note}}</view>
          </view>
          <view class="bc" data-bc="pace">
            <view class="bc-h"><view class="ico ico-trend"></view><text class="bc-t">节奏分段</text></view>
            <view class="ph" wx:for="{{forecast.pace.phases}}" wx:key="i">
              <text class="pi">第 {{item.i}} 段</text><text class="pt">{{item.from}} → {{item.to}}</text>
              <text class="pm">{{item.mean}}<text class="u">{{item.unit}}</text></text>
              <text class="pn">n={{item.n}} · 最大 {{item.max}}</text>
            </view>
            <view class="bc-note">{{forecast.pace.note}}</view>
          </view>
        </view>
      </block>

      <view class="section-head detail-heading">
        <text class="section-title">历史分布</text>
        <text class="section-sub">n = {{survivalN}} 次历史间隔</text>
      </view>
      <view class="lede">三张图看同一批已完成间隔：常见区间、等待生存曲线与每次间隔分布。</view>
      <view class="hr-grid">
        <view wx:if="{{histShow}}" class="hr">
          <view class="hr-h"><text class="hr-t">重置通常发生在第几天</text><text class="hr-n">n = {{survivalN}}</text></view>
          <canvas type="2d" id="hist" class="chart chart-hist"></canvas>
        </view>
        <view class="hr">
          <view class="hr-h"><text class="hr-t">等待生存曲线</text><text class="hr-n">n = {{survivalN}}</text></view>
          <canvas type="2d" id="survival" class="chart chart-survival"></canvas>
        </view>
        <view class="hr">
          <view class="hr-h"><text class="hr-t">每次间隔的离散分布</text><text class="hr-n">n = {{survivalN}}</text></view>
          <canvas type="2d" id="strip" class="chart chart-strip"></canvas>
          <view class="legend">
            <view class="lg"><text class="sw sw-lan"></text>常规间隔</view>
            <view class="lg"><text class="sw sw-mist"></text>偏长间隔</view>
            <view class="lg"><text class="sw sw-cin"></text>极端长等待</view>
          </view>
        </view>
      </view>

      <view class="section-head detail-heading"><text class="section-title">样本摘要</text></view>
      <view class="metrics">
        <view class="metric" wx:for="{{metrics}}" wx:key="k">
          <view class="v {{item.hi ? 'hl' : ''}}">{{item.v}}<text wx:if="{{item.u}}" class="u">{{item.u}}</text></view>
          <view class="k">{{item.k}}</view><view class="note">{{item.note}}</view>
        </view>
      </view>

      <view wx:if="{{remind.show}}" class="remind card">
        <view class="rd-head"><text class="rd-t">{{remind.title}}</text><text class="rd-tag">一次性</text></view>
        <view class="rd-hint">{{remind.hint}}</view>
        <view class="rd-btn {{remind.state}}" bindtap="onToggleRemind">{{remind.label}}</view>
        <view wx:if="{{remind.feedback}}" class="rd-fb {{remind.tone}}">{{remind.feedback}}</view>
      </view>
    </view>

    <view class="foot">
      <view>数据：公开推文记录 · 最近一次采集 {{genText}} 北京</view>
      <view>观测账号 x.com/{{account}}</view>
    </view>
  </view>
</view>
