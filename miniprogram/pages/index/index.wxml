<!-- 观测台首页：*下一次什么时候* → 凭什么 → 图表 → 已经等了多久 / 历史详情

     ⚠ 顺序是这一页最要紧的设计，改动前先读这一句：
     改版前首屏的三块分别在回答「规则是什么」（每日重置窗口）、「有没有公告」（信号）、
     「已经等了多久」（大计数器）—— **没有一块在回答用户要的那个问题**。
     所以现在的第一块是 `pred`（预测总览），其余按「结论 → 依据 → 图表 → 详情」排。 -->

<!-- `sp` = 单页模式（朋友圈点开）下的底部让位类，给微信固定的「前往小程序」
     操作栏腾出位置。取值与理由见 app.wxss 的 `.wrap.sp`。 -->
<view class="wrap {{singlePage ? 'sp' : ''}}">

  <!-- ============ 顶栏 ============ -->
  <view class="top">
    <view class="brand">
      <text class="h1">等 TIBO 按按钮</text>
      <text class="sub">RESET OBSERVATORY</text>
    </view>
    <view class="pulse {{degraded ? 'warn' : ''}}">
      <text class="dot"></text>
      <text>{{updText}}</text>
    </view>
  </view>

  <!-- 数据不是实时的就明说，不假装 -->
  <view wx:if="{{notice}}" class="notice">{{notice}}</view>

  <!-- ============ 第一层：预测总览 ============ -->
  <!-- 首屏主角。这一块回答四个问题：下一次什么时候（大字 + 大倒计时）、
       可不可信（置信度条）、凭什么（一句话依据摘要）、还有多久（倒计时本身）。
       判据来自共享模块 utils/outlook.js（与网页端逐字同一份文件），这里只排版。

       `data-status` / `data-level` 是样式钩子，不要用它们做逻辑判断。 -->
  <view wx:if="{{pred}}" class="pred" data-status="{{pred.status}}" data-level="{{pred.confidence}}">
    <view class="pred-head">
      <text class="pred-t">下一次重置预测</text>
      <text class="pred-badge">{{pred.statusLabel}}</text>
    </view>

    <!-- 状态与依据来源：两句话都不是自我评价，是事实陈述 -->
    <view class="pred-note">{{pred.statusNote}} · {{pred.etaNote}}</view>

    <view class="pred-eta">
      <text class="pe-md">{{pred.md}}</text>
      <text class="pe-rest">{{pred.wd}} {{pred.hm}}</text>
    </view>

    <view class="pred-cd {{pred.cd.over ? 'is-over' : ''}}">
      <text class="pcd-cap">{{pred.cd.label}}</text>
      <view class="pcd-row">
        <view class="pcd-g" wx:for="{{pred.cd.groups}}" wx:key="unit">
          <text class="pcd-v">{{item.v}}</text>
          <text class="pcd-u">{{item.unit}}</text>
        </view>
      </view>
      <view wx:if="{{pred.band}}" class="pred-band">
        <text class="pb-k">{{pred.bandLabel}}</text>
        <text class="pb-v">{{pred.band}}</text>
      </view>
    </view>

    <view class="pred-brief">{{pred.brief}}</view>

    <view class="pred-foot">
      <text class="pf-k">置信度</text>
      <text class="pf-v">{{pred.confidenceLabel}}</text>
      <!-- 置信度可视化：按高/中/低三档拉开宽度。纯文字档位会被读成形容词，
           一条长度不同的横条才是可比较的量。 -->
      <view class="pf-bar"><view class="pf-fill" style="width:{{pred.confidenceW}}%"></view></view>
      <text class="pf-upd">预测算于 {{pred.updatedText}}</text>
    </view>
  </view>

  <!-- ============ 信号 ============ -->
  <!-- 有预告时这块是**预测总览的依据**：Tibo 把时间说死了，结论就不是推算。
       只有「情绪」没有时间的推文进不到这里（规则见 utils/view.js 的 buildSignal）。 -->
  <view wx:if="{{signal.show}}" class="sig" data-level="{{signal.level}}">
    <view class="sig-halo"></view>

    <view class="sig-head">
      <text class="badge"><text class="bdot"></text>{{signal.badge}}</text>
      <text class="sig-title">{{signal.title}}</text>
    </view>

    <view wx:if="{{signal.headline}}" class="ann">
      <text class="ann-cap">预告时间</text>
      <text class="ann-big">{{signal.headline.big}}</text>
      <text class="ann-sub">{{signal.headline.sub}}</text>
    </view>

    <!-- ⛔ 这里**没有**「距窗口开启」的倒数，是刻意去掉的。
         公告档下主卡的锚点就是窗口开启时刻（`etaAt === window.fromTs`），
         两个同值、同尺寸、只差几秒的大数字叠在同一屏上互相抵消 —— 主角被稀释。
         往前看的那**一个**读数归主卡；这块只负责「他说了什么、原文在哪」。
         可核对性没有丢：窗口开启时刻由下面 .win 块以「北京时间 ⋯ 起」给出。 -->
    <view wx:if="{{signal.window}}" class="win">
      <view class="wrow">
        <text class="k">Tibo 当地时间</text>
        <text class="v">{{signal.window.sourceZone}}</text>
        <text class="z">{{signal.window.srcOffset}}</text>
      </view>
      <view class="wrow">
        <text class="k">北京时间</text>
        <text class="v">{{signal.window.userZone}}</text>
        <text class="z">{{signal.window.usrOffset}}</text>
      </view>
      <view class="wfoot">
        {{signal.window.diffText}}{{signal.window.rangeNote ? ' · ' + signal.window.rangeNote : ''}}
      </view>
      <text wx:if="{{signal.precision}}" class="wprec">粒度：{{signal.precision}}</text>
    </view>

    <!-- **这条预告依据的推文**。一条预告 = 一个时间窗口，支撑它的推文就列在这里，
         不另起一块 —— 旧版是「横幅（只挂最新一条原文）+ 另起一行计数 + 独立摘要块」，
         读的人得自己在这三处之间拼出归属关系（见 decisions.md 的 D-018）。
         默认收起：手机一屏装不下「窗口 + 4 条推文 + 倒计时」，而倒计时是这一页的主角；
         摘要行照常显示条数与构成，归属关系不会丢。 -->
    <view wx:if="{{signal.evCount}}" class="ev">
      <view class="ev-head" bindtap="onToggleEv">
        <text class="ev-t">依据 {{signal.evCount}} 条推文</text>
        <text wx:if="{{signal.evMix}}" class="ev-mix">{{signal.evMix}}</text>
        <text class="ev-toggle">{{signal.evOpen ? '收起' : '展开'}}</text>
      </view>
      <view wx:if="{{signal.evOpen}}" class="ev-body">
        <text wx:if="{{signal.evNote}}" class="ev-note">{{signal.evNote}}</text>
        <view
          wx:for="{{signal.ev}}"
          wx:key="id"
          class="ev-item {{item.weight === 'hard' ? 'hard' : ''}}"
        >
          <view class="ev-top">
            <text class="ev-when">{{item.when}} 北京</text>
            <text class="ev-tag {{item.weight}}">{{item.tag}}</text>
            <text wx:if="{{item.via}}" class="ev-via">{{item.via}}</text>
            <text wx:if="{{item.word}}" class="ev-word">{{item.word}}</text>
          </view>
          <text class="ev-quote">{{item.text}}</text>
          <!-- 单页模式（朋友圈打开）下剪贴板是被禁能力，点了只会弹
               「请前往小程序使用完整服务」—— 让位，不摆一个点了弹错的入口 -->
          <text
            wx:if="{{item.url && !singlePage}}"
            class="ev-link"
            data-url="{{item.url}}"
            bindtap="onCopySource"
          >复制原推链接</text>
        </view>
      </view>
    </view>

    <view wx:if="{{!signal.evCount}}" class="quote">{{signal.text}}</view>

    <view class="meta">
      <text wx:if="{{signal.createdText}}">发布于 {{signal.createdText}}</text>
      <text wx:if="{{signal.timeNote}}" class="note">{{signal.timeNote}}</text>
      <text wx:if="{{signal.reason}}">判定依据：{{signal.reason}}</text>
      <text wx:if="{{signal.url && !signal.evCount && !singlePage}}" class="link" bindtap="onCopySource">复制原推链接</text>
    </view>
  </view>

  <!-- 「没有预告」本身是一条信息，不是一个空状态：它把「扫了多少条、一条都没命中」
       摆出来，读者才知道这份「没有」是有分量的。点它滚到「已经等了多久」——
       没有预告时，那正是下一个该看的数字（等多久了、在历史里算什么位置）。
       网页端是同一条信息走锚点链接，落点都是同一块。 -->
  <view wx:else class="sig-idle" bindtap="onIdleTap">
    <view class="idle-ico"></view>
    <view class="idle-body">
      <text class="idle-t">最近 <text class="b">{{signal.checked}}</text> 条推文中没有检测到重置预告</text>
      <!-- 取不到窗口起点时整行不出现 —— 否则渲染成「时间窗自  起」，比没有更差 -->
      <text wx:if="{{signal.windowFrom}}" class="idle-sub">时间窗自 {{signal.windowFrom}} 起</text>
    </view>
    <text class="idle-go">›</text>
  </view>

  <!-- ============ 第二层：预测依据 ============ -->
  <!-- 三张卡，各自独立成立、挑着读也行：① 还要等多久、区间多宽 ② 这个模型准不准
       ③ 历史节奏在怎么变。旧版这里是「一块数字 + 两张表」，四块并排看下来像一张
       表而不像三张卡 ——「信息太碎」的根因正在这里。
       卡底的结语**不是写死的**：它由共享模块 utils/outlook.js 按三项判据算出来
       （见 view.js 的 buildForecast），判据漂了那句话会自己跟着变。 -->
  <block wx:if="{{forecast}}">
    <view class="sec-head">
      <text class="t">预测依据</text>
      <text class="h">{{forecast.hint}}</text>
    </view>

    <view class="bc-grid">

      <!-- ① 中位剩余等待 -->
      <view class="bc" data-bc="wait">
        <view class="bc-h">
          <view class="ico ico-wait"></view>
          <text class="bc-t">中位剩余等待</text>
        </view>
        <view class="bc-num">
          <text class="b">{{forecast.wait.num}}</text>
          <text class="u">{{forecast.wait.unit}}</text>
        </view>
        <view class="bc-range">{{forecast.wait.range}}</view>
        <view class="bc-bar" wx:for="{{forecast.wait.bars}}" wx:key="label">
          <text class="lb">{{item.label}}</text>
          <view class="track"><view class="fill" style="width: {{item.w}}%"></view></view>
          <text class="pv">{{item.pv}}</text>
        </view>
        <!-- 概率没有做过校准，这一点必须留在数字旁边，不能用散文代替 -->
        <view class="bc-note is-warn">{{forecast.wait.warn}}</view>
      </view>

      <!-- ② 样本外回测：四行数字，前三项与样本量一起决定主卡上那个置信度 -->
      <view class="bc" data-bc="backtest">
        <view class="bc-h">
          <view class="ico ico-bars"></view>
          <text class="bc-t">样本外回测</text>
        </view>
        <view class="bc-sub">n = {{forecast.backtest.n}}（阈值 ≥ {{forecast.backtest.minN}}）</view>
        <view class="bc-row" wx:for="{{forecast.backtest.rows}}" wx:key="k">
          <text class="k">{{item.k}}</text>
          <text class="v {{item.ok ? 'good' : 'bad'}}">{{item.v}}</text>
          <text class="j">{{item.j}}</text>
        </view>
        <view class="bc-note" data-note="backtest">{{forecast.backtest.note}}</view>
      </view>

      <!-- ③ 节奏在加速 -->
      <view class="bc" data-bc="pace">
        <view class="bc-h">
          <view class="ico ico-trend"></view>
          <text class="bc-t">节奏在加速</text>
        </view>
        <view class="ph" wx:for="{{forecast.pace.phases}}" wx:key="i">
          <text class="pi">第 {{item.i}} 段</text>
          <text class="pt">{{item.from}} → {{item.to}}</text>
          <text class="pm">{{item.mean}}<text class="u">{{item.unit}}</text></text>
          <text class="pn">n={{item.n}} · 最大 {{item.max}}</text>
        </view>
        <view class="bc-note">{{forecast.pace.note}}</view>
      </view>

    </view>
  </block>

  <!-- ============ 每日重置窗口 ============ -->
  <!-- 他宣布「未来 N 天里每天要么发一个改进、要么给一次完整重置」。
       它**不在** signal.show 那个门里：这条规则与「有没有某一天的预告」是两件事，
       放进那道门就等于「没有预告时这条规则也不存在」。样式刻意比 .sig 轻。

       ⚠ 位置在**预测依据之后**：它讲的是规则，不是结论。摆在预测总览后面会挤进
       首屏，而首屏要留给「下一次什么时候、还有多久」—— 读者先读到「射程范围」，
       等于把结论推下去一屏。旧版（更早）甚至把它放在全页第一块。 -->
  <view wx:if="{{signal.program.show}}" class="prog">
    <view class="prog-head">
      <view class="ico ico-cal"></view>
      <text class="prog-tag">每日重置窗口</text>
      <text class="prog-left">共 <text class="n">{{signal.program.days}}</text> 天 · 还剩 <text class="n">{{signal.program.daysLeft}}</text> 天</text>
    </view>
    <text class="prog-rule">每天要么发一个改进、要么给一次完整重置 —— 期间任何一天都可能重置</text>
    <view wx:if="{{signal.program.window}}" class="win">
      <view class="wrow">
        <text class="k">Tibo 当地时间</text>
        <text class="v">{{signal.program.window.sourceZone}}</text>
        <text class="z">{{signal.program.window.srcOffset}}</text>
      </view>
      <view class="wrow">
        <text class="k">北京时间</text>
        <text class="v">{{signal.program.window.userZone}}</text>
        <text class="z">{{signal.program.window.usrOffset}}</text>
      </view>
      <view class="wfoot">
        {{signal.program.window.diffText}}{{signal.program.window.rangeNote ? ' · ' + signal.program.window.rangeNote : ''}}
      </view>
    </view>
    <view class="prog-meta">
      <text wx:if="{{signal.program.announcedText}}">发布于 {{signal.program.announcedText}}</text>
      <!-- 复制链接（不是 open-type），与别处一致：隐私接口被拒时必须有提示，不静默 -->
      <text
        wx:if="{{signal.program.url && !singlePage}}"
        class="prog-link"
        data-url="{{signal.program.url}}"
        bindtap="onCopySource"
      >复制原推链接</text>
    </view>
  </view>

  <!-- ============ 第三层：历史规律（三张图一组） ============ -->
  <!-- 三张图共用一行标题与一条题注。旧版每张图各有一个标题 + 一段引导文，六行文字
       把三张图切成三件事，而它们回答的其实是同一个问题的三个侧面。分组之后图的
       归属由**组**给出，不再靠重复标题。 -->
  <view class="sec-head">
    <text class="t">历史规律</text>
    <text class="h">n = {{survivalN}} 次历史间隔</text>
  </view>
  <view class="lede">
    三张图看的是同一批历史间隔：哪一档最容易发生、到第 X 天为止发生了多少、每次各是几天。
  </view>
  <view class="lede lede-2">
    直方图横轴按区间等宽分档（不是按天数），纵轴是落在该档的次数；高亮那一档就是你当前所在的一档。
  </view>

  <view class="hr-grid">
    <!-- ① 重置通常发生在第几天。直接服务预测结论：高亮的那一档 = 现在等的时间算长还是短 -->
    <view wx:if="{{histShow}}" class="hr">
      <view class="hr-h">
        <text class="hr-t">重置通常发生在第几天</text>
        <text class="hr-n">n = {{survivalN}}</text>
      </view>
      <canvas type="2d" id="hist" class="chart chart-hist"></canvas>
    </view>

    <!-- ② 等待生存曲线：纵轴是「到第 X 天为止，历史上百分之多少的重置已经发生」 -->
    <view class="hr">
      <view class="hr-h">
        <text class="hr-t">等待生存曲线</text>
        <text class="hr-n">n = {{survivalN}}</text>
      </view>
      <canvas type="2d" id="survival" class="chart chart-survival"></canvas>
    </view>

    <!-- ③ 每次间隔的离散分布：平均值被右侧的极端值拉高了 -->
    <view class="hr">
      <view class="hr-h">
        <text class="hr-t">每次间隔的离散分布</text>
        <text class="hr-n">n = {{survivalN}}</text>
      </view>
      <canvas type="2d" id="strip" class="chart chart-strip"></canvas>
      <view class="legend">
        <view class="lg"><text class="sw sw-lan"></text>常规间隔</view>
        <view class="lg"><text class="sw sw-mist"></text>偏长间隔</view>
        <view class="lg"><text class="sw sw-cin"></text>极端长等待</view>
      </view>
    </view>
  </view>

  <!-- ============ 第四层：已等多久 / 样本摘要 ============ -->
  <view class="sec-head">
    <text class="t">已经等了多久</text>
  </view>

  <view class="hero">
    <view class="label">距上一次额度重置</view>

    <view class="counter">
      <view class="grp" wx:for="{{counter}}" wx:key="unit" wx:for-item="g">
        <view class="reels">
          <view class="reel" wx:for="{{g.digits}}" wx:key="index" wx:for-item="d">
            <view class="strip" style="transform: translateY(-{{d}}em)">
              <view class="dg" wx:for="{{digits}}" wx:key="*this" wx:for-item="n">{{n}}</view>
            </view>
          </view>
        </view>
        <text class="unit">{{g.unit}}</text>
      </view>
    </view>

    <view class="since">{{since}}</view>
    <view class="verdict v-{{verdict.cls}}">
      <text class="b">{{verdict.text}}</text>
      <text class="sep"> · </text>
      <text>{{verdict.tail}}</text>
    </view>

    <!-- 等待进度尺：同一件事的视觉版本 —— 扫一眼就知道「等了多久」 -->
    <view wx:if="{{gauge}}" class="gauge g-{{gauge.cls}}">
      <view class="g-track"><view class="g-fill" style="width:{{gauge.fill}}%"></view></view>
      <view class="g-text">{{gauge.text}}</view>
    </view>
  </view>

  <view class="sec-head">
    <text class="t">样本摘要</text>
  </view>

  <view class="metrics">
    <view class="metric" wx:for="{{metrics}}" wx:key="k">
      <!-- 值在上、标签在下：这一栏读者扫的是数字，标签只在认不出这个数字时用来
           解释它。标签占先会把六个数字全推到第二眼。 -->
      <view class="v {{item.hi ? 'hl' : ''}}">{{item.v}}<text wx:if="{{item.u}}" class="u">{{item.u}}</text></view>
      <view class="k">{{item.k}}</view>
      <view class="note">{{item.note}}</view>
    </view>
  </view>

  <!-- ============ F9 一次性提醒 ============ -->
  <!-- 文案必须说清「一次授权 = 一次通知」。长期订阅不对工具类目开放，
       写成「订阅通知」会让用户以为一次授权永久有效 —— 那是误导。 -->
  <view wx:if="{{remind.show}}" class="remind card">
    <view class="rd-head">
      <text class="rd-t">{{remind.title}}</text>
      <text class="rd-tag">一次性</text>
    </view>
    <view class="rd-hint">{{remind.hint}}</view>
    <view class="rd-btn {{remind.state}}" bindtap="onToggleRemind">{{remind.label}}</view>
    <view wx:if="{{remind.feedback}}" class="rd-fb {{remind.tone}}">{{remind.feedback}}</view>
  </view>

  <!-- ============ 页脚 ============ -->
  <view class="foot">
    <view>数据：公开推文记录 · 最近一次采集 {{genText}} 北京</view>
    <view>观测账号 x.com/{{account}}</view>
    <!-- 单页模式下 `navigator` 是被禁组件（点了不响应），且官方运营须知明确
         「不得诱导或强制用户点击『打开小程序』」—— 所以直接不渲染。
         底部本来就有微信固定的「前往小程序」操作栏，不缺口子。 -->
    <navigator wx:if="{{!singlePage}}" class="nav" url="/pages/history/index" open-type="navigate">查看完整历史记录 →</navigator>
  </view>

</view>
