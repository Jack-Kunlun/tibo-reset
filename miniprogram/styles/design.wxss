.design .tr-sheet .tr-observation-detail { display:flex; flex-direction:column; gap:14rpx; margin-top:22rpx; padding:20rpx; border:2rpx solid #9c8bd833; border-radius:16rpx; background:#a99ae20c; }
.design .tr-observation-time { color:#d0c3ff; font-size:22rpx; line-height:1.5; }
.design .tr-observation-scope { color:#a4abc4; font-size:21rpx; line-height:1.55; }

.design .tr-enable { width: auto; min-width: 92rpx; }

.design .tr-reminder-copy > .tr-strong { color: #f2f0fc; }
.design .tr-enable.is-idle { width: 92rpx; min-width: 92rpx; max-width: 92rpx; }
.design .tr-enable-all.is-idle { width: 100%; min-width: 0; max-width: none; }
